# Copy this file to .env and fill in real values before running the server.

# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Where the SQLite database file lives. The default is fine for most setups.
DATABASE_URL=sqlite:///app.db

# The first admin account is created automatically on first run using these
# credentials, if no admin user exists yet. Change the password after your
# first login (there's no in-app "change password" yet — see README).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API. Add your deployed
# frontend's URL here in production (e.g. https://ucwestpark.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email notifications (Resend) ---
# Get an API key at https://resend.com after creating a free account.
# Leave RESEND_API_KEY blank to disable email notifications entirely — the
# app will keep working, it just won't send emails.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend. For quick
# testing before you verify your own domain, Resend provides a sandbox
# sender you can use as-is:
RESEND_FROM_EMAIL=UCwestpark Parking <onboarding@resend.dev>
# Where new-request notifications are sent.
ADMIN_NOTIFICATION_EMAIL=you@example.com

# If this API sits behind a reverse proxy / custom domain, set this to the
# public base URL so uploaded image links are correct. Leave blank to
# auto-detect from the incoming request (fine for most single-server setups).
PUBLIC_BASE_URL=
